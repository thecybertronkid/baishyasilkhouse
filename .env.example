# Supabase PostgreSQL Database Connection Strings
# Transaction connection pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_SUPABASE_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR_SUPABASE_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
